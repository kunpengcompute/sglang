+# conda-forge's msgpack-c ships only the C library headers (msgpack.h,
+# msgpack/*.h). Mooncake's store uses the C++ header <msgpack.hpp>, which
+# lives in the separate cpp branch of the same upstream project and is not
+# packaged on conda-forge, so install it headers-only into the Conda
+# environment. Pin to the same version as the conda msgpack-c package so the
+# C and C++ headers stay consistent.
+print_section "Installing msgpack C++ headers"
+
+MSGPACK_C_VERSION=$(conda list -f msgpack-c 2>/dev/null | awk '$1=="msgpack-c" {print $2; exit}')
+if [ -z "${MSGPACK_C_VERSION}" ]; then
+    MSGPACK_C_VERSION="6.1.0"
+fi
+echo "Fetching msgpack-cpp ${MSGPACK_C_VERSION} headers from ${GITHUB_PROXY}..."
+MSGPACK_CPP_TGZ="$(mktemp --suffix=.tar.gz)"
+MSGPACK_TMP="$(mktemp -d)"
+curl -fsSL -o "${MSGPACK_CPP_TGZ}" \
+    "${GITHUB_PROXY}/msgpack/msgpack-c/archive/refs/tags/cpp-${MSGPACK_C_VERSION}.tar.gz"
+check_success "Failed to download msgpack-cpp ${MSGPACK_C_VERSION} headers"
+tar -xzf "${MSGPACK_CPP_TGZ}" -C "${MSGPACK_TMP}"
+check_success "Failed to extract msgpack-cpp headers"
+# Replace the C-only msgpack/ directory with the cpp branch's complete
+# header set (C + C++), so <msgpack.hpp> resolves.
+rm -rf "${CONDA_PREFIX}/include/msgpack"
+cp -r "${MSGPACK_TMP}"/msgpack-c-cpp-*/include/msgpack.hpp \
+      "${MSGPACK_TMP}"/msgpack-c-cpp-*/include/msgpack \
+      "${CONDA_PREFIX}/include/"
+check_success "Failed to install msgpack C++ headers into ${CONDA_PREFIX}/include"
+rm -f "${MSGPACK_CPP_TGZ}"
+rm -rf "${MSGPACK_TMP}"
+
+print_success "msgpack C++ headers installed into ${CONDA_PREFIX}/include"
 
