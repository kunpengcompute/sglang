diff --git a/mooncake-common/common.cmake b/mooncake-common/common.cmake
index 0b801728..06a93549 100644
--- a/mooncake-common/common.cmake
+++ b/mooncake-common/common.cmake
@@ -11,6 +11,19 @@ set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -Wextra -Wno-unused-parameter -fPIC")
 if(ENABLE_DEBUG_SYMBOLS)
   set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -g")
   set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -g")
+else()
+  # CMake's built-in per-config defaults (e.g. RelWithDebInfo = "-O2 -g
+  # -DNDEBUG") re-introduce -g after the block above, so ENABLE_DEBUG_SYMBOLS=OFF
+  # alone would not actually drop debug info.  Strip -g from the per-config
+  # flags as well so the knob really disables debug symbols (this also greatly
+  # reduces peak compiler memory, which matters on memory-constrained build
+  # machines).
+  foreach(_debug_config RELWITHDEBINFO DEBUG RELEASE MINSIZEREL)
+    string(REGEX REPLACE "(^| )-g( |$)" " "
+           CMAKE_CXX_FLAGS_${_debug_config} "${CMAKE_CXX_FLAGS_${_debug_config}}")
+    string(REGEX REPLACE "(^| )-g( |$)" " "
+           CMAKE_C_FLAGS_${_debug_config} "${CMAKE_C_FLAGS_${_debug_config}}")
+  endforeach()
 endif()
 
