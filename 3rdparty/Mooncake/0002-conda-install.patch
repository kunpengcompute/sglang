+                patchelf \
+                libnl"
+
+# C standard library headers (libc6-dev equivalent). cxx-compiler pulls the
+# matching sysroot in automatically, but install it explicitly to be clear.
+SYSROOT_PKG="sysroot_linux-64"
+if [ "$(uname -m)" = "aarch64" ]; then
+    SYSROOT_PKG="sysroot_linux-aarch64"
 fi
 
-print_success "System packages installed successfully"
